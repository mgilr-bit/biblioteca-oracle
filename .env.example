# ============================================================================
# Base de Datos Oracle
# ============================================================================
DB_USER=biblioteca_user
DB_PASSWORD=TU_PASSWORD_AQUI

# Oracle Autonomous Database (cloud.oracle.com) con TLS de una vía (sin wallet).
# Descriptor completo desde: Database Connection -> Connection Strings -> TLS.
# En OCI: "Mutual TLS authentication = Not required" + IP del cliente en la ACL.
# Todo en una sola línea. Déjala vacía/comentada para usar el Oracle XE local.
#DB_DSN=(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=adb.TU-REGION.oraclecloud.com))(connect_data=(service_name=XXXX_biblioteca_low.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

# Oracle XE local (solo se usa si DB_DSN está ausente/vacía)
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=XEPDB1

# Entorno: development | production
ENV=development

# IMPORTANTE: Cambiar en producción a una clave aleatoria y segura
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAR_ESTA_CLAVE_EN_PRODUCCION

# CORS - Dominios permitidos (separados por comas)
# En desarrollo: puertos locales
# En producción: dominio de tu aplicación
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Puerto del servidor
PORT=5000

# Redis (sesiones + rate limiting)
REDIS_URL=redis://localhost:6379/0
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=604800
